# ==========================================================================
# Personal Finance Manager - example environment file.
# Copy to `.env` and adjust. Every value has a safe development default.
# ==========================================================================

# --- App ---
PFM_ENVIRONMENT=development            # development | staging | production
PFM_DEBUG=true
PFM_APP_NAME="Personal Finance Manager API"

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PFM_SECRET_KEY=change-me-in-production-openssl-rand-hex-32
PFM_ACCESS_TOKEN_EXPIRE_MINUTES=120
PFM_BCRYPT_ROUNDS=12

# --- Database ---
# SQLite (zero-config, great for local dev)
PFM_DATABASE_URL=sqlite:///./pfm.db
# PostgreSQL (production / docker compose)
# PFM_DATABASE_URL=postgresql+psycopg://pfm:pfm@localhost:5432/pfm

# --- CORS (comma separated). The bundled dashboard is same-origin, so it needs none.
PFM_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate limiting (per client IP, per minute) ---
PFM_RATE_LIMIT_ENABLED=true
PFM_RATE_LIMIT_PER_MINUTE=120
PFM_AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Demo data ---
PFM_SEED_DEMO_USER=true
PFM_DEMO_EMAIL=demo@pfm.app
PFM_DEMO_PASSWORD=demo1234
